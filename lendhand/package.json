{
  "name": "lendhand-recruitment",
  "version": "1.0.0",
  "description": "LendHand candidate registration site and admin dashboard (zero runtime dependencies).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "create-admin": "node --disable-warning=ExperimentalWarning scripts/create-admin.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "purge": "node --disable-warning=ExperimentalWarning scripts/purge.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  }
}
